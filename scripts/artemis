#!/usr/bin/env bash
# artemis — Agent CLI on PATH (Windows-safe naming).
#   artemis              → Agent CLI / TUI
#   artemis desktop|gui  → Artemis Desktop (installed app when present)
set -euo pipefail

unset PYTHONPATH
unset PYTHONHOME

export ARTEMIS_HOME="${ARTEMIS_HOME:-$HOME/.artemis}"
export ARTEMIS_DESKTOP_APP_NAME="${ARTEMIS_DESKTOP_APP_NAME:-Artemis}"

if [[ -n "${ARTEMIS_ROOT:-}" ]]; then
  LINK_ROOT="$ARTEMIS_ROOT"
elif [[ -e /usr/local/lib/artemis-agent ]]; then
  LINK_ROOT=/usr/local/lib/artemis-agent
elif [[ -e "$HOME/.local/lib/artemis-agent" ]]; then
  LINK_ROOT="$HOME/.local/lib/artemis-agent"
elif [[ -e "$ARTEMIS_HOME/artemis-agent" ]]; then
  LINK_ROOT="$ARTEMIS_HOME/artemis-agent"
else
  LINK_ROOT="$ARTEMIS_HOME/artemis-agent"
fi

ROOT="$(readlink -f "$LINK_ROOT" 2>/dev/null || echo "$LINK_ROOT")"
PY="$ROOT/venv/bin/python"
# Prefer the real console-script entry; never recurse into this wrapper.
CLI_BIN="$ROOT/venv/bin/artemis-cli"
if [[ ! -x "$CLI_BIN" ]]; then
  CLI_BIN="$ROOT/venv/bin/artemis"
fi
ENTRY_PY="$ROOT/artemis"

resolve_desktop() {
  if [[ -n "${ARTEMIS_DESKTOP_BIN:-}" && -x "${ARTEMIS_DESKTOP_BIN}" ]]; then
    printf '%s\n' "$ARTEMIS_DESKTOP_BIN"
    return 0
  fi
  for cand in /usr/bin/Artemis /opt/Artemis/Artemis /usr/local/bin/Artemis; do
    if [[ -x "$cand" ]]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

# Fast path: plain `artemis desktop` / `artemis gui` → installed Desktop.
if [[ "${1:-}" == "desktop" || "${1:-}" == "gui" ]]; then
  shift
  wants_dev=0
  for a in "$@"; do
    case "$a" in
      --source|--build-only|--force-build|--fake-boot|--skip-build|--artemis-root|--artemis-root=*)
        wants_dev=1
        ;;
    esac
  done
  if [[ "$wants_dev" -eq 0 ]]; then
    if DESKTOP="$(resolve_desktop)"; then
      exec "$DESKTOP" "$@"
    fi
  fi
  # Fall through to Agent CLI (builds from source when needed).
  set -- desktop "$@"
fi

if [[ ! -x "$PY" ]]; then
  echo "Artemis engine not found at $LINK_ROOT (-> $ROOT)" >&2
  exit 1
fi

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<HELP
Artemis — AI assistant with tool-calling capabilities

Usage:
  artemis [options] [prompt]     Agent CLI / TUI
  artemis desktop               Open Artemis Desktop (installed app)
  artemis chat | gateway | model | status | doctor | ...

Engine link: $LINK_ROOT
Data:        \$HOME/.artemis
HELP
fi

export ARTEMIS_ENGINE_ROOT="$LINK_ROOT"

if [[ "${1:-}" == "update" ]]; then
  echo "Artemis updates come from GitHub Releases."
  echo "  https://github.com/lipey1/artemis-desktop/releases/latest"
  echo "Download the asset for your OS and install it over the current build."
  exit 0
fi

# Real CLI entry (Python module). Prefer console script if it is not this bash wrapper.
if [[ -x "$CLI_BIN" ]] && ! head -1 "$CLI_BIN" | grep -q 'bash'; then
  exec "$CLI_BIN" "$@"
fi
if [[ -f "$ENTRY_PY" ]]; then
  exec "$PY" "$ENTRY_PY" "$@"
fi
exec "$PY" -m artemis_cli.main "$@"
